# Prism IA — backend environment template
# Never commit real secrets to GitHub. Configure these in Render/Vercel Environment Variables.

DATABASE_URL=
JWT_SECRET=
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
OPENCODE_ZEN_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-latest
OPENAI_MODEL=gpt-4.1
GEMINI_MODEL=gemini-2.5-pro

# MCP: encryption key for per-user bearer credentials.
# Use a long random secret and keep it only in the backend environment.
MCP_ENCRYPTION_KEY=
MCP_ALLOW_PRIVATE_HOSTS=false
MCP_ALLOW_HTTP=false

# Optional built-in GitHub MCP server.
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_MCP_TOKEN=

# Rolling five-hour usage window. Override these defaults per deployment if needed.
# Values represent requests reserved inside the active window, not money or message credits.
PRISM_FREE_WINDOW_LIMIT=5
PRISM_BASE_WINDOW_LIMIT=30
PRISM_MEDIUM_WINDOW_LIMIT=700
PRISM_PRO_WINDOW_LIMIT=2000
PRISM_ENTERPRISE_WINDOW_LIMIT=6000
PRISM_IP_RATE_LIMIT=120

# Frontend: set only when the API is hosted separately from the frontend.
VITE_API_URL=

# Optional GitHub OAuth / MCP integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
