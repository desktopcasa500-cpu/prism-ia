# Prism IA — backend environment template
# Never commit real secrets to GitHub. Configure these in Render/Vercel Environment Variables.

DATABASE_URL=
JWT_SECRET=
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
OPENCODE_ZEN_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-latest
OPENAI_MODEL=gpt-4.1
GEMINI_MODEL=gemini-2.5-pro

# MCP: encryption key for per-user bearer credentials.
# Use a long random secret and keep it only in the backend environment.
MCP_ENCRYPTION_KEY=
MCP_ALLOW_PRIVATE_HOSTS=false
MCP_ALLOW_HTTP=false

# Optional built-in GitHub MCP server.
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_MCP_TOKEN=

# Usage: daily rolling 24-hour window + fixed weekly reset Sunday 00:00 in user timezone.
# Exact product limits are enforced in backend/src/services/usage.js.
PRISM_FREE_DAILY_LIMIT=5
PRISM_BASE_DAILY_LIMIT=30
PRISM_MEDIUM_DAILY_LIMIT=700
PRISM_PRO_DAILY_LIMIT=2000
PRISM_ENTERPRISE_DAILY_LIMIT=6000
PRISM_FREE_WEEKLY_LIMIT=100
PRISM_BASE_WEEKLY_LIMIT=500
PRISM_MEDIUM_WEEKLY_LIMIT=3000
PRISM_PRO_WEEKLY_LIMIT=10000
PRISM_ENTERPRISE_WEEKLY_LIMIT=30000

# Aggregate traffic protection and queue priority.
PRISM_RPM_LIMIT=120
PRISM_MAX_CONCURRENT_GENERATIONS=12
PRISM_IP_RATE_LIMIT=120

# Stripe stays inactive until explicitly enabled. When false, checkout is simulated locally.
PRISM_STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRISM_STRIPE_PRICE_BASE=
PRISM_STRIPE_PRICE_MEDIUM=
PRISM_STRIPE_PRICE_PRO=
PRISM_STRIPE_PRICE_ENTERPRISE=

# Frontend: set only when the API is hosted separately from the frontend.
VITE_API_URL=

# Optional GitHub OAuth / MCP integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
