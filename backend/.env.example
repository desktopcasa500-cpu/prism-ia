# Variáveis locais / Vercel. Nunca commite valores reais.

PORT=4000
NODE_ENV=development

# Banco Postgres
DATABASE_URL=postgres://user:password@host:5432/prism_ia

# Sessão
JWT_SECRET=troque-por-um-segredo-forte-aleatorio
JWT_EXPIRES_IN=7d

# Login Google — o mesmo Client ID usado pelo frontend
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# Provedores de IA (backend apenas — nunca expor ao frontend)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_NVIDIA_API_KEY=
NVIDIA_BUILDER_API_KEY=

# Frontend local ou domínio público
FRONTEND_ORIGIN=http://localhost:5173
