# Copie este arquivo para .env e preencha com suas chaves reais.
# NUNCA commite o .env — ele já está no .gitignore.

PORT=4000
NODE_ENV=development

# Postgres (Vercel Postgres, Supabase, Neon, etc.)
DATABASE_URL=postgres://user:password@host:5432/prism_ia

# JWT
JWT_SECRET=troque-por-um-segredo-forte-aleatorio
JWT_EXPIRES_IN=7d

# Provedores de IA (backend apenas — nunca expor ao frontend)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_NVIDIA_API_KEY=
NVIDIA_BUILDER_API_KEY=

# CORS
FRONTEND_ORIGIN=http://localhost:5173
