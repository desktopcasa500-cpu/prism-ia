{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/reset-usage",
      "schedule": "10 2 * * *"
    },
    {
      "path": "/api/cron/refresh-news",
      "schedule": "10 3 * * *"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/index.js"
    }
  ]
}
