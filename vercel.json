{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/reset-usage",
      "schedule": "10 2 * * *"
    },
    {
      "path": "/api/cron/refresh-news",
      "schedule": "10 3 * * *"
    }
  ],
  "buildCommand": "if [ -n \"$DATABASE_URL\" ] || [ -n \"$DATABASE\" ] || [ -n \"$POSTGRES_URL\" ] || [ -n \"$POSTGRES_PRISMA_URL\" ] || [ -n \"$POSTGRES_URL_NON_POOLING\" ]; then npm run migrate; fi; npm run check && npm run build",
  "rewrites": [
    { "source": "/login", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/chat", "destination": "/index.html" },
    { "source": "/codex", "destination": "/index.html" },
    { "source": "/studio", "destination": "/index.html" },
    { "source": "/configuracoes", "destination": "/index.html" },
    { "source": "/workspace", "destination": "/index.html" },
    { "source": "/prism-taff", "destination": "/index.html" },
    { "source": "/modelos", "destination": "/index.html" },
    { "source": "/modelos/:id", "destination": "/index.html" },
    { "source": "/informacoes", "destination": "/index.html" },
    { "source": "/informacoes/:id", "destination": "/index.html" },
    { "source": "/termos", "destination": "/index.html" },
    { "source": "/termos/:topic", "destination": "/index.html" }
  ]
}
